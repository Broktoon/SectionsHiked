# Claude Code internal settings
.claude/

# Wrangler local build artifacts
.wrangler/

# Node
node_modules/

# Unused reference/backup geojson — kept locally, not deployed
public/trails/appalachian-trail/data/trail_backup.geojson
public/trails/ice-age-trail/data/trail_backup.geojson
public/trails/new-england-trail/data/trail_backup.geojson
public/trails/new-england-trail/data/points_backup.json
# ^ pre-rebuild NET data; the originals are also in git history at 218ac86
#   (the commit before the NPS centerline rebuild)
public/trails/pacific-crest-trail/data/Full_PCT_Simplified.geojson
public/trails/pacific-crest-trail/data/points_backup.json
public/trails/pacific-crest-trail/data/trail_backup.geojson
# ^ pre-rebuild PCT data; the originals are also in git history at e3078c0
#   (the commit before the PCTA rebuild)

# PCTA section/region source layers: 36MB each, fetched on demand by
# scripts/build-pct-data.js. The small derived product it actually needs,
# scripts/cache/pcta_assignment.json, IS committed, so a rebuild does not
# have to redownload these.
scripts/cache/pcta_letter_sections.geojson
scripts/cache/pcta_regions.geojson
public/trails/continental-divide-trail/data/points_backup.json
public/trails/continental-divide-trail/data/trail_backup.geojson
# ^ pre-rebuild CDT data; the originals are also in git history at 086d6a3
#   (the commit before the CDTC rebuild)

# CDTC source layers: 64MB each, fetched on demand by scripts/build-cdt-data.js.
# The small inputs it also needs (half-mile markers, the OSM alternate relations,
# Census state boundaries) ARE committed, so only these two need refetching.
scripts/cache/cdtc_sections.geojson
scripts/cache/cdtc_centerline.geojson

# NCTA source layers fetched on demand by scripts/build-nct-data.js: the
# centerline (18.7MB), NCTA's Superior Hiking Trail layer (8.1MB) and the Census
# state polygons (5.8MB). All three come from stable public endpoints and the
# script refetches any that are missing. The one small input it also needs,
# scripts/cache/nct_halfmile_markers.json, IS committed — that is the axis
# cross-check, and it is the file worth having pinned to what the build was
# validated against.
#
# There are no nct points_backup/trail_backup files: the pre-rebuild NCT data is
# in git history at 79dfaf2 (the commit before the NCTA rebuild).
scripts/cache/nct_centerline.json
scripts/cache/nct_sht.json
scripts/cache/census_states_nct.geojson
